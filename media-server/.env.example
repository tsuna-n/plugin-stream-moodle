# Copy this file to .env (same folder) and fill in real values before
# running `docker compose up -d`. .env is gitignored.

# Two subdomains, both pointing (A/AAAA record) at this server's public IP.
# Caddy requests a free Let's Encrypt certificate for each automatically on
# first start — DNS must already be live, or issuance fails. They must be
# different names (see Caddyfile for why HLS and playback can't share one
# domain with different paths).
HLS_DOMAIN=live.media.example.com
PLAYBACK_DOMAIN=vod.media.example.com

# Email Let's Encrypt sends renewal/expiry notices to. Not shown publicly.
ACME_EMAIL=admin@example.com
